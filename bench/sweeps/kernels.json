    {"label": "naive", "args": ["--attention-backend", "naive"]},
    {"label": "flashinfer", "args": ["--attention-backend", "flashinfer"]},
    {"label": "flashinfer-graphs", "args": ["--attention-backend", "flashinfer", "--cuda-graphs"]}
  ]
}
